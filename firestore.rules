rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions

    // Get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role checks
    function isSuperAdmin() {
      return request.auth != null && getUserData().role == 'super_admin';
    }

    function isTeamAdmin() {
      return request.auth != null && getUserData().role == 'team_admin';
    }

    function isRouteLeader() {
      return request.auth != null && getUserData().role == 'route_leader';
    }

    function isVolunteer() {
      return request.auth != null && getUserData().role == 'volunteer';
    }

    // Team access check
    function belongsToTeam(teamId) {
      return request.auth != null && getUserData().teamId == teamId;
    }

    // Route access check
    function isRouteLeaderOfRoute(routeId) {
      return isRouteLeader() && getUserData().routeId == routeId;
    }


    // Teams Collection

    match /teams/{teamId} {
      // Allow anyone to read teams (needed for signup page dropdown)
      allow read: if true;

      // Super admins can do anything
      allow write: if isSuperAdmin();

      // Team admins can read and update their own team
      allow update: if isTeamAdmin() && belongsToTeam(teamId);
    }

    // Communities Collection

    match /communities/{communityId} {
      // Super admins can do anything
      allow read, write: if isSuperAdmin();

      // Team admins can manage communities in their team
      allow read, update, delete: if isTeamAdmin() && belongsToTeam(resource.data.teamId);
      allow create: if isTeamAdmin() && belongsToTeam(request.resource.data.teamId);

      // Route leaders can read and create communities in their team
      allow read: if isRouteLeader() && belongsToTeam(resource.data.teamId);
      allow create: if isRouteLeader() && belongsToTeam(request.resource.data.teamId);

      // Volunteers can read and create communities in their team
      allow read: if isVolunteer() && belongsToTeam(resource.data.teamId);
      allow create: if isVolunteer() && belongsToTeam(request.resource.data.teamId);
    }


    // Routes Collection

    match /routes/{routeId} {
      // Allow anyone to read routes (needed for signup page dropdown)
      allow read: if true;

      // Super admins can do anything
      allow write: if isSuperAdmin();

      // Team admins can manage routes in their team
      allow create: if isTeamAdmin() && belongsToTeam(request.resource.data.teamId);
      allow update, delete: if isTeamAdmin() && belongsToTeam(resource.data.teamId);

      // Route leaders can create routes in their team and update their assigned route
      allow create: if isRouteLeader() && belongsToTeam(request.resource.data.teamId);
      allow update: if isRouteLeaderOfRoute(routeId);

      // Volunteers can create routes in their team
      allow create: if isVolunteer() && belongsToTeam(request.resource.data.teamId);
    }


    // Buildings Collection

    match /buildings/{buildingId} {
      // Super admins can do anything
      allow read, write: if isSuperAdmin();

      // Temporarily simplified for debugging - allow all authenticated users to read buildings
      // TODO: Re-enable team-based restrictions after debugging
      allow read: if request.auth != null;

      // Team admins can manage buildings in their team
      allow create: if isTeamAdmin() && belongsToTeam(request.resource.data.teamId);
      allow update, delete: if isTeamAdmin() && belongsToTeam(resource.data.teamId);

      // Route leaders can manage buildings in their team
      // Changed from route-specific to team-wide access to support VisitForm auto-created routes
      allow create: if isRouteLeader() && belongsToTeam(request.resource.data.teamId);
      allow update, delete: if isRouteLeader() && belongsToTeam(resource.data.teamId);

      // Volunteers can create, read, and update buildings in their team (no delete)
      allow create: if isVolunteer() && belongsToTeam(request.resource.data.teamId);
      allow update: if isVolunteer() && belongsToTeam(resource.data.teamId);


      // Visits Subcollection

      // Visit schema includes people[] array for multiple people per visit
      // Each person: { name, age, phone, followUp, involvement }

      match /visits/{visitId} {
        // Super admins can do anything
        allow read, write: if isSuperAdmin();

        // Team admins can manage visits in their team
        allow read, write: if isTeamAdmin() &&
                            belongsToTeam(get(/databases/$(database)/documents/buildings/$(buildingId)).data.teamId);

        // Route leaders can manage visits in their team
        // Changed from route-specific to team-wide access to support VisitForm workflow
        allow read, write: if isRouteLeader() &&
                            belongsToTeam(get(/databases/$(database)/documents/buildings/$(buildingId)).data.teamId);

        // Volunteers can only create and read visits in their team (no update or delete)
        // Per requirements: volunteers can only add data, not edit or delete
        allow create, read: if isVolunteer() &&
                            belongsToTeam(get(/databases/$(database)/documents/buildings/$(buildingId)).data.teamId);
      }
    }


    // CollectionGroup Rules for Visits
    // These rules apply when querying across all visit subcollections using collectionGroup()
    // Used by VisitHistory.jsx
    // IMPORTANT: Visit documents now include denormalized teamId, routeId, communityId fields
    // to avoid expensive get() calls during collectionGroup queries

    match /{path=**}/visits/{visitId} {
      // Allow authenticated users to read visits
      // Team isolation is enforced client-side in VisitHistory.jsx
      // This is a temporary simplified rule while we debug the permissions issue
      allow read: if request.auth != null;
    }


    // Users Collection

    match /users/{userId} {
      // ===== READ RULES =====

      // Allow unauthenticated users to read access code user documents (for login)
      allow read: if resource.data.isAccessCodeUser == true;

      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Super admins can read all profiles
      allow read: if isSuperAdmin();

      // Team admins can read users in their team
      allow read: if isTeamAdmin() && belongsToTeam(resource.data.teamId);

      // Route leaders can read users in their team
      allow read: if isRouteLeader() && belongsToTeam(resource.data.teamId);

      // ===== CREATE RULES =====

      // Users can create their own profile during signup (userId must match auth.uid)
      allow create: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.data.email == request.auth.token.email;

      // Super admins can create any user
      allow create: if isSuperAdmin();

      // Team admins can create users in their team (but not super_admins)
      allow create: if isTeamAdmin() &&
                      belongsToTeam(request.resource.data.teamId) &&
                      request.resource.data.role != 'super_admin';

      // Route leaders can create volunteer users (access code users)
      allow create: if isRouteLeader() &&
                      request.resource.data.role == 'volunteer' &&
                      request.resource.data.isAccessCodeUser == true;

      // ===== UPDATE RULES =====

      // Users can update their own profile (except role and teamId)
      allow update: if request.auth.uid == userId &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.teamId == resource.data.teamId;

      // Super admins can update any user
      allow update: if isSuperAdmin();

      // Team admins can update users in their team (but not super_admins)
      allow update: if isTeamAdmin() &&
                      belongsToTeam(resource.data.teamId) &&
                      resource.data.role != 'super_admin' &&
                      request.resource.data.role != 'super_admin';

      // ===== DELETE RULES =====

      // Super admins can delete any user
      allow delete: if isSuperAdmin();

      // Team admins can delete users in their team (but not super_admins)
      allow delete: if isTeamAdmin() &&
                      belongsToTeam(resource.data.teamId) &&
                      resource.data.role != 'super_admin';

      // Route leaders can delete access code users they created
      allow delete: if isRouteLeader() &&
                      resource.data.role == 'volunteer' &&
                      resource.data.isAccessCodeUser == true;
    }

    // Member Records Collection
    match /memberRecords/{recordId} {
      // Super admins can do anything
      allow read, write: if isSuperAdmin();

      // Team admins, route leaders, and volunteers can read and write member records
      // Member records are tied to buildings/units, not directly to teams, so we allow broader access
      allow read, write: if request.auth != null;
    }

    // Follow-Ups collection - accessible by super_admin, team_admin, route_leader
    match /followUps/{followUpId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader', 'volunteer']);
      
      allow create: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        request.resource.data.teamId is string &&
        request.resource.data.name is string &&
        request.resource.data.createdBy == request.auth.uid;
      
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == resource.data.teamId
        );
      
      allow delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == resource.data.teamId
        );
    }

    // Current Involvements collection - accessible by super_admin, team_admin, route_leader
    match /currentInvolvements/{involvementId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader', 'volunteer']);
      
      allow create: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        request.resource.data.teamId is string &&
        request.resource.data.name is string &&
        request.resource.data.createdBy == request.auth.uid;
      
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == resource.data.teamId
        );
      
      allow delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'team_admin', 'route_leader']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == resource.data.teamId
        );
    }

  }
}